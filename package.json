{
  "name": "gscf-disputes",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:libs:dev && ng serve disputes",
    "build": "npm run build:libs && ng build disputes",
    "build:libs": "ng build ui-common && ng build ui-form && ng build ui-notifications",
    "build:libs:dev": "ng build ui-common --configuration development && ng build ui-form --configuration development && ng build ui-notifications --configuration development",
    "watch:libs": "ng build ui-common --configuration development --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps libs --max-warnings 0",
    "test": "npm run build:libs && ng test --watch=false && npm run test:node",
    "test:watch": "npm run build:libs && ng test disputes --watch",
    "test:components": "ng test ui-common --configuration browser --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:types": "tsc -p e2e/tsconfig.json",
    "build:prod": "npm run build",
    "build:dev": "npm run build:libs:dev && ng build disputes --configuration development",
    "build:demo": "npm run build:libs && ng build disputes --configuration demo",
    "mock:worker": "msw init apps/disputes/mocks --no-save",
    "test:node": "vitest run --config vitest.node.config.mts",
    "storybook": "npm run build:libs && npm run docs:components && ng run disputes:storybook",
    "build:storybook": "npm run build:libs && npm run docs:components && ng run disputes:build-storybook",
    "test:storybook:types": "npm run docs:components && tsc --noEmit -p .storybook/tsconfig.json",
    "docs:components": "compodoc -p .storybook/tsconfig.compodoc.json -e json -d .compodoc --silent",
    "test:stories": "playwright test --config .storybook/playwright.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "22.2.7",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/material": "22.2.7",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.2202.7",
    "@angular-devkit/build-angular": "22.2.7",
    "@angular-devkit/core": "22.2.7",
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@axe-core/playwright": "4.14.0",
    "@compodoc/compodoc": "2.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/angular": "10.6.7",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-boundaries": "7.4.3",
    "jsdom": "31.0.1",
    "msw": "3.0.5",
    "ng-packagr": "22.2.6",
    "playwright": "1.65.1",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  }
}
