{
  "name": "gscf-disputes",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:libs:dev && ng serve disputes",
    "build": "npm run build:libs && ng build disputes",
    "build:libs": "ng build ui-common",
    "build:libs:dev": "ng build ui-common --configuration development",
    "watch:libs": "ng build ui-common --configuration development --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps libs --max-warnings 0",
    "test": "npm run build:libs && ng test --watch=false",
    "test:watch": "npm run build:libs && ng test disputes --watch",
    "test:components": "ng test ui-common --configuration browser --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:types": "tsc -p e2e/tsconfig.json"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-boundaries": "7.4.3",
    "jsdom": "31.0.1",
    "ng-packagr": "22.2.6",
    "playwright": "1.65.1",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  }
}
