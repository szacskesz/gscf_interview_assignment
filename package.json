{
  "name": "gscf-disputes",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:libs:dev && ng serve disputes",
    "build": "npm run build:libs && ng build disputes",
    "build:libs": "ng build ui-common",
    "build:libs:dev": "ng build ui-common --configuration development",
    "watch:libs": "ng build ui-common --configuration development --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "ng-packagr": "22.2.6",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  }
}
