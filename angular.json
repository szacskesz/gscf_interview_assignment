{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "apps",
  "projects": {
    "disputes": {
      "projectType": "application",
      "root": "apps/disputes",
      "sourceRoot": "apps/disputes/src",
      "prefix": "gscf",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/disputes/src/main.ts",
            "tsConfig": "apps/disputes/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/disputes/public"
              }
            ],
            "styles": ["apps/disputes/src/styles.css"],
            "define": {
              "COMPILE_TIME_ENABLE_MOCK": "false"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "outputPath": "dist/apps/disputes/production"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputPath": "dist/apps/disputes/development",
              "define": {
                "COMPILE_TIME_ENABLE_MOCK": "true"
              },
              "fileReplacements": [
                {
                  "replace": "apps/disputes/src/environments/environment.ts",
                  "with": "apps/disputes/src/environments/environment.mock.ts"
                }
              ],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "apps/disputes/public"
                },
                {
                  "glob": "mockServiceWorker.js",
                  "input": "apps/disputes/mocks",
                  "output": "/"
                }
              ]
            },
            "demo": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "outputPath": "dist/apps/disputes/demo",
              "define": {
                "COMPILE_TIME_ENABLE_MOCK": "true"
              },
              "fileReplacements": [
                {
                  "replace": "apps/disputes/src/environments/environment.ts",
                  "with": "apps/disputes/src/environments/environment.mock.ts"
                }
              ],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "apps/disputes/public"
                },
                {
                  "glob": "mockServiceWorker.js",
                  "input": "apps/disputes/mocks",
                  "output": "/"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "disputes:build:production"
            },
            "development": {
              "buildTarget": "disputes:build:development"
            },
            "demo": {
              "buildTarget": "disputes:build:demo"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/disputes/tsconfig.spec.json",
            "exclude": ["**/*.browser.spec.ts", "**/*.node.spec.ts"],
            "isolate": true
          }
        }
      }
    },
    "ui-common": {
      "projectType": "library",
      "root": "libs/ui/common",
      "sourceRoot": "libs/ui/common/src",
      "prefix": "gscf",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/ui/common/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/ui/common/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/ui/common/tsconfig.spec.json",
            "exclude": ["**/*.browser.spec.ts", "**/*.node.spec.ts"],
            "isolate": true
          },
          "configurations": {
            "browser": {
              "tsConfig": "libs/ui/common/tsconfig.browser-spec.json",
              "include": ["**/*.browser.spec.ts"],
              "exclude": [],
              "browsers": ["ChromiumHeadless"]
            }
          }
        }
      }
    }
  }
}
