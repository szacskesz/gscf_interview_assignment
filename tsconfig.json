{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@gscf/ui-common": ["./dist/libs/ui/common"],
      "@gscf/ui-form": ["./dist/libs/ui/form"],
      "@gscf/ui-notifications": ["./dist/libs/ui/notifications"],
      "@gscf/core": ["./dist/libs/core"],
      "@gscf/disputes-data-access": ["./dist/libs/data-access/disputes"],
      "@gscf/disputes-mock": ["./dist/libs/data-access/disputes-mock"],
      "@gscf/disputes-feature": ["./dist/libs/feature/disputes"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./apps/disputes/tsconfig.app.json"
    },
    {
      "path": "./apps/disputes/tsconfig.spec.json"
    },
    {
      "path": "./libs/ui/common/tsconfig.lib.json"
    },
    {
      "path": "./libs/ui/common/tsconfig.spec.json"
    },
    {
      "path": "./libs/ui/common/tsconfig.browser-spec.json"
    },
    {
      "path": "./libs/ui/form/tsconfig.lib.json"
    },
    {
      "path": "./libs/ui/notifications/tsconfig.lib.json"
    },
    {
      "path": "./libs/core/tsconfig.lib.json"
    },
    {
      "path": "./libs/data-access/disputes/tsconfig.lib.json"
    },
    {
      "path": "./libs/data-access/disputes-mock/tsconfig.lib.json"
    },
    {
      "path": "./libs/feature/disputes/tsconfig.lib.json"
    }
  ]
}
